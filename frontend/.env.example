# =============================================================================
# /frontend/.env  —  VARIABLES INTERNAS DE LA APLICACIÓN NEXT.JS
# Este archivo lo carga el contenedor "frontend" en tiempo de ejecución.
# =============================================================================

# --- Servidor de desarrollo ---
PORT=3000
NODE_ENV=development

# --- API pública (llamadas desde el NAVEGADOR del usuario) ---
# Apunta a localhost porque el navegador no está dentro de la red Docker.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Prefijo global del backend (Nest: setGlobalPrefix('api')). Por defecto: /api
# NEXT_PUBLIC_API_PATH_PREFIX=/api

# --- API interna (llamadas Server-Side: Server Components, Route Handlers) ---
# Usa el hostname del servicio Docker para comunicación contenedor-a-contenedor.
API_INTERNAL_URL=http://backend:3001
