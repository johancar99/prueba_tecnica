        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  const data = body.data || body;",
                  "  if (data.accessToken) pm.collectionVariables.set('accessToken', data.accessToken);",
                  "  if (data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "  if (data.user?.id) pm.collectionVariables.set('userId', data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nuevo.paciente@clinica.com\",\n  \"password\": \"Passw0rd!\",\n  \"name\": \"Nuevo Paciente\",\n  \"role\": \"PATIENT\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Registra un usuario (PATIENT o DOCTOR). Público."
          }
