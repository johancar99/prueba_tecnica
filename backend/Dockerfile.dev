# =============================================================================
# BACKEND — NestJS + Prisma  (Desarrollo local con Docker Compose)
# El código fuente se monta en tiempo de ejecución vía volumen (./backend:/app).
# En Railway se usa Nixpacks (ver railway.toml), no este archivo.
# =============================================================================
FROM node:20-alpine

RUN apk add --no-cache \
      openssl \
      libc6-compat \
      python3 \
      make \
      g++

WORKDIR /app

COPY package*.json ./
COPY prisma ./prisma/

ARG DATABASE_URL
ENV DATABASE_URL=${DATABASE_URL}

RUN npm install
RUN npx prisma generate || true

EXPOSE 3001

CMD ["npm", "run", "start:dev"]
