# =============================================================================
# /.env  —  ORQUESTACIÓN DOCKER COMPOSE
# Este archivo SOLO lo lee docker-compose.yml para levantar la infraestructura.
# Las variables de aplicación viven en backend/.env y frontend/.env
# =============================================================================

# --- Puertos expuestos al host ---
BACKEND_PORT=3001
FRONTEND_PORT=3000
POSTGRES_PORT=5432

# --- Credenciales de PostgreSQL (usadas por el servicio "db") ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret
POSTGRES_DB=prueba_tecnica_db
